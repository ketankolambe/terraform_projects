# ------------------------------------------------------------------------
# Official Terraform .gitignore Template
# ------------------------------------------------------------------------

# Local .terraform directories (contains downloaded plugins and modules)
**/.terraform/*

# .tfstate files (Contains sensitive, cleartext infrastructure data)
# Note: Use a remote backend (S3, Azure Blob, Terraform Cloud) instead of Git.
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log



# Ignore override files as they are used locally to override resources
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# CLI configuration files
.terraformrc
terraform.rc
vpc_peering_using_modules/env/.terraform.lock.hcl

environments/networking/vpc/dev/.terraform.lock.hcl
nvironments/networking/vpc/qa/.terraform.lock.hcl'
environments/storage/s3/dev/.terraform.lock.hcl
environments/compute/ec2/dev/.terraform.lock.hcl
environments/compute/ec2/prod/.terraform.lock.hcl
environments/compute/ec2/qa/.terraform.lock.hcl
environments/networking/vpc/prod/.terraform.lock.hcl
environments/networking/vpc/uat/.terraform.lock.hcl
environments/storage/dev/.terraform.lock.hcl



static-website-hosting-s3/environments/DNS/.terraform.lock.hcl
static-website-hosting-s3/environments/Security/ACM/.terraform.lock.hcl
static-website-hosting-s3/environments/Storage/S3/dev/.terraform.lock.hcl